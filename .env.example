# Set STORY_BACKEND=supabase and STORY_AUTH_MODE=account to enable accounts.
STORY_BACKEND=file
STORY_AUTH_MODE=legacy

# Browser-safe values. These are public configuration, not secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
STORY_GOOGLE_SIGN_IN=false
STORY_EMAIL_CODE_SIGN_IN=false
SUPABASE_BUCKET=story-bridge-audio

# SERVER-ONLY: never put this value in VITE_* variables or frontend code.
SUPABASE_SECRET_KEY=

# Set to a local fake JWKS only for tests. Production discovers the project's published keys.
STORY_TEST_JWKS=

# Optional, server-only AI translation drafts. Never use a VITE_ prefix.
OPENAI_API_KEY=
# Optional model override; defaults in server/translation-draft.js.
OPENAI_TRANSLATION_MODEL=
# Optional server-only model retried once when the primary model is missing or access is denied.
OPENAI_TRANSLATION_FALLBACK_MODEL=
